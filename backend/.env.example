# Copy this file to .env and fill in your values
# NEVER commit .env — it's in .gitignore

# Demo mode — set to 'true' to run without PostgreSQL/Redis (in-memory storage)
# Uses pre-seeded demo user (demo@adtraffic.ai / demo123). Data resets on restart.
# DEMO_MODE=true

# PostgreSQL connection string (required unless DEMO_MODE=true)
DATABASE_URL=postgres://adtraffic:password@localhost:5432/adtraffic

# Claude API key.
# NOTE: As of the per-user-key change, this is NO LONGER used by the chat path.
# Every user now connects their own Claude API key in Settings → Claude API, and
# Kiki calls Anthropic with that per-user key (stored encrypted at rest). The app
# itself no longer reads this variable; it is retained only for any external tooling
# you run separately. Leave it unset if nothing needs it. Kiki will not respond until
# a key is connected in Settings.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model — use cheapest for testing, upgrade for production
# Options: claude-haiku-4-5-20251001 (cheapest), claude-sonnet-4-5-20250929, claude-opus-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Max tokens per response (lower = cheaper, 1024 is fine for testing)
CLAUDE_MAX_TOKENS=1024

# Daily API request limit (resets at midnight). Prevents runaway costs.
DAILY_API_LIMIT=50

# Server port (default: 3001)
PORT=3001

# JWT secret for session tokens (generate a random string for production)
JWT_SECRET=dev-secret-change-in-production

# Role for users registered AFTER the first one: senior | junior (default junior).
# The FIRST account on a fresh instance is always 'admin' (the operator who
# stands it up); this setting does not affect them. Later registrants default to
# 'junior' (read + write-pending-approval) so open registration can't silently
# grant direct live-write authority on real ad spend. Set 'senior' on a
# trusted-team instance where every user should write directly. Any other value
# (including 'admin') is ignored and falls back to 'junior'.
# DEFAULT_USER_ROLE=junior

# Sentry error reporting (optional — leave blank to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional bearer token for the /metrics endpoint. Leave blank to keep /metrics
# open (protect it via network policy / reverse proxy). If set, scrapers must send
# `Authorization: Bearer <token>` (Prometheus supports `bearer_token`).
METRICS_TOKEN=

# Usage telemetry (PostHog). A real, write-only project key ships committed in
# src/telemetry/config.ts, so anonymous telemetry is ON by default. These vars
# are OVERRIDES only:
#   • POSTHOG_KEY= (empty)  → turns telemetry OFF for this deployment
#   • POSTHOG_KEY=phc_...   → send to a different PostHog project
#   • POSTHOG_HOST=...      → set your region (default US; EU below)
# Individual users can also opt out locally with `npm run telemetry`.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com   # use https://eu.i.posthog.com for EU region

# Redis password (required in production for Docker Compose requirepass)
# REDIS_PASSWORD=your-redis-password

# Redis connection URL (optional — falls back to in-memory if unavailable)
# REDIS_URL=redis://localhost:6379

# TTL for conversation history cache in Redis (seconds, default: 86400 = 24 hours)
# HISTORY_CACHE_TTL_SECONDS=86400

# Google OAuth2 for CM360 connection (optional — without these, Kiki uses demo data)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
WEBAPP_URL=http://localhost:5173

# Chrome extension ID for CORS lockdown (required in production)
# Find in chrome://extensions after publishing
# CHROME_EXTENSION_ID=abcdefghijklmnopqrstuvwxyz123456

# Separate HMAC secret for OAuth state signing (optional — falls back to JWT_SECRET)
# OAUTH_STATE_SECRET=

# AES-256 encryption key for OAuth tokens at rest (64 hex chars)
# Leave blank in dev — derives from JWT_SECRET automatically
ENCRYPTION_KEY=

# Instance identifier for log correlation (auto-set from hostname if omitted)
# INSTANCE_ID=backend-1

# Log level override (default: 'debug' in dev, 'info' in production, 'silent' in test)
# Options: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=info

# Feature flags defaults (JSON string, optional — overrides registry defaults)
# Example: {"cm360.write_operations":false,"limits.daily_api_requests":50}
# FEATURE_FLAGS_DEFAULTS=
