{
  "manifest_version": 3,
  "name": "AdTraffic.ai — Kiki for CM360",
  "version": "0.1.0",
  "description": "Quick-launch Kiki, your CM360 trafficking assistant, with page context",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://campaignmanager.google.com/*",
        "http://localhost:5173/mock-cm360*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
